#!/bin/bash

# 脚本目录
script_dir=$(cd $(dirname $0);pwd)
# 脚本目录和名
mkPath=$script_dir
mkPathName=${mkPath##*/}
# 备份目录
tmpPath=$(grep 'bakPath' $script_dir/config)
tmpPath=${tmpPath//\$HOME/$HOME}
bakPath=${tmpPath##*=}/$mkPathName
cd $HOME
if [ -d "$script_dir" ];then
        today=$(date -d "now" +"%Y%m%d%H%M")
        strPath=$HOME/$mkPathName-$today.zip
	echo "压缩目录：$script_dir"
	zip -qr $strPath ./$mkPathName
        echo "备份文件：$strPath 压缩文件备份到$bakPath"
        if [ ! -d "$bakPath" ];then
        	echo "创建目录：$bakPath"
                mkdir -p "$bakPath"
        fi  
	cp -f $strPath $bakPath
	rm -f $strPath
fi

