#!/bin/bash

# 脚本目录
script_dir=$(cd $(dirname $0);pwd)
cd $script_dir
# 源码版本
tmpPath=$(grep 'openwrt_ver' $script_dir/config)
openwrt_ver=${tmpPath##*=}
# 源码目录和名
tmpPath=$(grep 'srcPathName' $script_dir/config)
srcPathName=${tmpPath##*=}
srcPath=$HOME/$srcPathName
# 脚本目录和名
mkPath=$script_dir
mkPathName=${mkPath##*/}
mkcPath=$script_dir/mkconfig
# 备份目录
tmpPath=$(grep 'bakPath' $script_dir/config)
tmpPath=${tmpPath//\$HOME/$HOME}
bakPath=${tmpPath##*=}/$mkPathName
# 固件输出目录
tmpPath=$(grep 'outPath' $script_dir/config)
tmpPath=${tmpPath//\$HOME/$HOME}
outPath=${tmpPath##*=}/$srcPathName
tempUrl=$(grep 'srcUrl' $script_dir/config)
srcUrl=${tempUrl##*=}
# 修改主机名
tmpHostname=$(grep 'reHostname' $script_dir/config)
reHostname=${tmpHostname##*=}
# 修改wifi名
wifiName=QingYu
# 启用增加固件脚本
tmpaddFir=$(grep 'addFir' $script_dir/config)
addFir=${tmpaddFir##*=}

cd $srcPath
if [ ! -f ".config" ];then
	strChips=x86
	strBit=64
	strModel=generic
	echo "CONFIG_TARGET_$strChips=y" >.config
	echo "CONFIG_TARGET_$strChips_$strBit=y">>.config
	echo "CONFIG_TARGET_$strChips_$strBit_DEVICE_$strModel=y">>.config
	echo \#=============================================
	echo \# '生成文件：'$strModel
	echo \#=============================================
	make defconfig
fi
./scripts/feeds update -a
./scripts/feeds install -a
make -j$(nproc) download

